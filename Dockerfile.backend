FROM python:3.11-slim

# Install system dependencies required for OpenCV and MediaPipe
RUN apt-get update && apt-get install -y \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy requirements, remove Windows-specific packages, and install
COPY r.txt .
RUN grep -v "tensorflow-intel" r.txt > docker_reqs.txt || true \
    && pip install --no-cache-dir -r docker_reqs.txt

# Copy the entire backend module including the models
COPY backend/ ./backend/

EXPOSE 8000

# Run FastAPI using uvicorn
CMD ["uvicorn", "backend.server:app", "--host", "0.0.0.0", "--port", "8000"]
